includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - src/
        - config/

    level: 6

    # Loaded only on Filament sites; Filament is not a dependency of this package.
    excludePaths:
        - src/Filament/

    ignoreErrors:
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/rastro.php
